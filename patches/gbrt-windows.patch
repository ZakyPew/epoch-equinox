diff --git "a/runtime/src/windows_optional_stubs.c" "b/runtime/src/windows_optional_stubs.c"
new file mode 100644
index 0000000..23188f6
--- /dev/null
+++ "b/runtime/src/windows_optional_stubs.c"
@@ -0,0 +1,165 @@
+/* Windows fallbacks for optional runtime modules that are still POSIX-only.
+ * The emulator/player, video, audio, input, saves, mods, and voxel renderer do
+ * not depend on these features. Keeping their public APIs present lets the
+ * normal SDL UI run while clearly reporting the features as unavailable. */
+
+#include "serial_link.h"
+#include "network_discovery.h"
+#include "pokemon/mock_inject_file.h"
+#include "cheats.h"
+#include "gb_printer.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* gb_printer.c normally owns this implementation. The Windows test build
+ * stubs the printer, but the SDL layer still uses PNG writing for borders. */
+#define STB_IMAGE_WRITE_IMPLEMENTATION
+#include "stb_image_write.h"
+
+/* BGB link cable --------------------------------------------------------- */
+bool gb_serial_link_start_listen(uint16_t port) {
+    (void)port;
+    return false;
+}
+
+bool gb_serial_link_start_connect(const char* host, uint16_t port) {
+    (void)host;
+    (void)port;
+    return false;
+}
+
+void gb_serial_link_shutdown(void) {}
+void gb_serial_link_init_from_env(void) {}
+bool gb_serial_link_is_active(void) { return false; }
+bool gb_serial_link_is_ready(void) { return false; }
+const char* gb_serial_link_peer_ip(void) { return ""; }
+void gb_serial_link_on_serial_byte(struct GBContext* ctx, uint8_t outgoing) {
+    (void)ctx;
+    (void)outgoing;
+}
+void gb_serial_link_tick(struct GBContext* ctx) { (void)ctx; }
+
+/* LAN discovery --------------------------------------------------------- */
+static char g_lan_uuid[GB_LAN_UUID_LEN] = "windows-offline";
+static char g_lan_nickname[GB_LAN_NICKNAME_LEN] = "Player";
+static uint16_t g_lan_port = 8765;
+static GBLanPrefsHooks g_lan_hooks;
+static bool g_lan_hooks_set = false;
+
+void gb_lan_set_prefs_hooks(const GBLanPrefsHooks* hooks) {
+    if (hooks) {
+        g_lan_hooks = *hooks;
+        g_lan_hooks_set = true;
+    } else {
+        memset(&g_lan_hooks, 0, sizeof(g_lan_hooks));
+        g_lan_hooks_set = false;
+    }
+}
+
+void gb_lan_init(void) {
+    if (g_lan_hooks_set && g_lan_hooks.load_string) {
+        g_lan_hooks.load_string("lan.uuid", g_lan_uuid, sizeof(g_lan_uuid));
+        g_lan_hooks.load_string("lan.nickname", g_lan_nickname,
+                                sizeof(g_lan_nickname));
+    }
+}
+
+void gb_lan_shutdown(void) {}
+void gb_lan_set_enabled(bool enabled) { (void)enabled; }
+bool gb_lan_is_enabled(void) { return false; }
+const char* gb_lan_self_uuid(void) { return g_lan_uuid; }
+const char* gb_lan_self_nickname(void) { return g_lan_nickname; }
+void gb_lan_set_self_nickname(const char* name) {
+    if (!name) return;
+    snprintf(g_lan_nickname, sizeof(g_lan_nickname), "%s", name);
+    if (g_lan_hooks_set && g_lan_hooks.save_string) {
+        g_lan_hooks.save_string("lan.nickname", g_lan_nickname);
+    }
+}
+void gb_lan_set_advertised_port(uint16_t port) { g_lan_port = port; }
+uint16_t gb_lan_advertised_port(void) { return g_lan_port; }
+size_t gb_lan_get_peers(GBLanPeer* out, size_t max) {
+    (void)out;
+    (void)max;
+    return 0;
+}
+
+/* Pokemon event-file injection ----------------------------------------- */
+int gb_inject_file_scan(const GBContext* ctx, const char* game_id,
+                        GBInjectFileEntry* out, int max) {
+    (void)ctx;
+    (void)game_id;
+    (void)out;
+    (void)max;
+    return 0;
+}
+
+bool gb_inject_file_describe(const GBContext* ctx,
+                             const GBInjectFileEntry* entry,
+                             char* out, size_t out_size) {
+    (void)ctx;
+    (void)entry;
+    if (out && out_size) snprintf(out, out_size, "Unavailable on this build");
+    return false;
+}
+
+bool gb_inject_file_apply(GBContext* ctx, const GBInjectFileEntry* entry,
+                          char* out_err, size_t err_size) {
+    (void)ctx;
+    (void)entry;
+    if (out_err && err_size) {
+        snprintf(out_err, err_size, "Unavailable on this build");
+    }
+    return false;
+}
+
+/* Cheat files ----------------------------------------------------------- */
+int gb_cheats_load(const char* game_id) {
+    (void)game_id;
+    return 0;
+}
+int gb_cheats_count(void) { return 0; }
+const GBCheat* gb_cheats_get(int idx) {
+    (void)idx;
+    return NULL;
+}
+void gb_cheats_set_enabled(GBContext* ctx, int idx, bool on) {
+    (void)ctx;
+    (void)idx;
+    (void)on;
+}
+void gb_cheats_set_op_value(GBContext* ctx, int cheat_idx,
+                            int op_idx, uint8_t value) {
+    (void)ctx;
+    (void)cheat_idx;
+    (void)op_idx;
+    (void)value;
+}
+void gb_cheats_disable_all(GBContext* ctx) { (void)ctx; }
+void gb_cheats_tick(GBContext* ctx) { (void)ctx; }
+
+/* Game Boy Printer ------------------------------------------------------ */
+struct GBPrinter { uint32_t print_count; };
+
+GBPrinter* gb_printer_create(void) {
+    return (GBPrinter*)calloc(1, sizeof(GBPrinter));
+}
+void gb_printer_destroy(GBPrinter* p) { free(p); }
+void gb_printer_set_output(GBPrinter* p, const char* dir,
+                           const char* prefix) {
+    (void)p;
+    (void)dir;
+    (void)prefix;
+}
+bool gb_printer_on_serial_byte(GBPrinter* p, GBContext* ctx,
+                               uint8_t outgoing) {
+    (void)p;
+    (void)ctx;
+    (void)outgoing;
+    return false;
+}
+uint32_t gb_printer_print_count(const GBPrinter* p) {
+    return p ? p->print_count : 0;
+}

