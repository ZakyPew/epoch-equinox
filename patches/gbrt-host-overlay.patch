+/* Rewind snapshots several times a second, and a log line per snapshot
+ * buries everything else in the run log. Hosts doing bulk state traffic
+ * turn the chatter off. */
+static bool gbrt_state_logging_quiet = false;
+
+void gb_context_set_state_logging_quiet(bool quiet) {
+    gbrt_state_logging_quiet = quiet;
+}
