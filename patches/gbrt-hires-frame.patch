+/* Host-supplied high-resolution frame: apply the same display colour
+ * correction as the normal Game Boy texture, then swizzle ARGB->RGBA into
+ * a staging buffer sized on demand. The voxel renderer reconstructs its
+ * colours directly from CGB palette RAM; treating that as already display-
+ * corrected made every high-resolution voxel mode neon while the untouched
+ * game used the selected GBC/GBA correction. */
+static GLuint g_hires_tex = 0;
+static int g_hires_tex_w = 0;
+static int g_hires_tex_h = 0;
+
+static uint32_t correct_hires_color(uint32_t c) {
+    static const int16_t cc_gbc[9] = {
+          893, 123,   8,    102, 840,  82,    102, 133, 789,
+    };
+    static const int16_t cc_gba[9] = {
+          860, 169,  -5,     92, 676, 256,     92, 261, 671,
+    };
+    const int16_t* cc = (g_color_correction == 1) ? cc_gbc :
+                        (g_color_correction == 2) ? cc_gba : NULL;
+    if (!cc) return c;
+    int r = (int)((c >> 16) & 0xFFu);
+    int g = (int)((c >> 8) & 0xFFu);
+    int b = (int)(c & 0xFFu);
+    int rn = (r * cc[0] + g * cc[1] + b * cc[2]) >> 10;
+    int gn = (r * cc[3] + g * cc[4] + b * cc[5]) >> 10;
+    int bn = (r * cc[6] + g * cc[7] + b * cc[8]) >> 10;
+    if (rn < 0) rn = 0; else if (rn > 255) rn = 255;
+    if (gn < 0) gn = 0; else if (gn > 255) gn = 255;
+    if (bn < 0) bn = 0; else if (bn > 255) bn = 255;
+    return (c & 0xFF000000u) | ((uint32_t)rn << 16) |
+           ((uint32_t)gn << 8) | (uint32_t)bn;
+}
+
+static void upload_hires_frame(void) {
+    static uint32_t* staging = NULL;
+    static size_t staging_px = 0;
+    size_t need = (size_t)g_hires_w * (size_t)g_hires_h;
+    if (need > staging_px) {
+        free(staging);
+        staging = (uint32_t*)malloc(need * sizeof(uint32_t));
+        staging_px = staging ? need : 0;
+    }
+    if (!staging) {
+        g_hires_src = NULL;
+        return;
+    }
+    for (size_t i = 0; i < need; i++) {
+        uint32_t c = correct_hires_color(g_hires_src[i]);
+        uint32_t a = c & 0xFF000000u;
+        uint32_t r = (c >> 16) & 0xFFu;
+        uint32_t g2 = (c >> 8) & 0xFFu;
+        uint32_t b = c & 0xFFu;
+        staging[i] = a | (b << 16) | (g2 << 8) | r;
+    }
+    if (!g_hires_tex) {
+        glGenTextures(1, &g_hires_tex);
+    }
+    glBindTexture(GL_TEXTURE_2D, g_hires_tex);
+    if (g_hires_tex_w != g_hires_w || g_hires_tex_h != g_hires_h) {
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, g_hires_w, g_hires_h, 0,
+                     GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        g_hires_tex_w = g_hires_w;
+        g_hires_tex_h = g_hires_h;
+    }
+    glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, g_hires_w, g_hires_h,
+                    GL_RGBA, GL_UNSIGNED_BYTE, staging);
+    glBindTexture(GL_TEXTURE_2D, 0);
+}
